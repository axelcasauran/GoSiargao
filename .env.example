# Convex deployment URL for the app (client-side, must be EXPO_PUBLIC_*).
# `npx convex dev` writes this into .env.local automatically — you usually
# don't edit it by hand. Copy this file to .env.local to set it manually.
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# NOTE: Google OAuth secrets are NOT stored here. They live on the Convex
# deployment (server-side). Set them with:
#   npx convex env set AUTH_GOOGLE_ID     <google-client-id>
#   npx convex env set AUTH_GOOGLE_SECRET <google-client-secret>
# See README.md → "Setup" for the full walkthrough.
